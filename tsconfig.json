{
  "compilerOptions": {
    "allowJs": true,
    "experimentalDecorators": true,
    "isolatedModules": true,
    "lib": [
      "es2021"
    ],
    "module": "commonjs",
    "noEmit": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "target": "es2021",
    "types": []
  },
  "exclude": [
    "Cache",
    "Packages",
    "node_modules",
    "node_modules/typescript/lib/lib.dom.d.ts"
  ],
  "include": [
    "./types/**/*.d.ts",
    "./Assets/**/*.ts"
  ]
}
